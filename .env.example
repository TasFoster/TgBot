# Telegram bot
BOT_TOKEN=123456:your-bot-token-here

# Comma-separated Telegram user IDs with admin rights
ADMIN_IDS=

# DB. For dev: sqlite. For prod use postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Logging
LOG_LEVEL=INFO

# Empty = polling. Set to https URL to enable webhook mode.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8080

# Default markup over Telegram star price, percent
DEFAULT_MARKUP_PCT=15

# How often to resync catalog from getAvailableGifts, seconds
CATALOG_SYNC_INTERVAL=3600
